# Property Information raw snapshots (dkk9-cj3x) — fetched by 06, like 01's above.
**/data/raw/Property_Information_Current_*.csv

# Shared-section data (City neighbourhood boundary + mature-neighbourhood
# reference downloads) — large, re-downloaded at refresh. Shared CODE under
# pipeline/yeg/shared/ stays committable; only its data/ is excluded (CLAUDE.md §3).
# Exclude the CONTENTS, not the directory: git cannot re-include a file whose
# parent DIRECTORY is excluded, so the oracle negation below needs data/* here.
pipeline/yeg/shared/data/*
# ...except the hand-curated rescue oracle — a ~2KB non-refetchable public-data
# ruling table, BP's live reconciliation source (Tier 1; a fresh clone needs it
# to build BP). The boundary + mature CSVs above stay ignored via data/*.
!pipeline/yeg/shared/data/neighbourhood_rescue_oracle.csv
**/building-permits/output/permits.pmtiles
**/building-permits/output/permit_geojson/*.geojson
# Point-map per-year GeoJSONs (01's 4b2 emit) — regenerable output; the published
# copies live in website/public/data/building-permits/permit-points/.
**/building-permits/output/permit_points/*.geojson

# Building-permits output/ regenerables (mirror PA's output/ convention above):
# per-year aggregates, coverage summary, manifest, and the served-copy-source
# CSVs (the published copies live in website/public/data/building-permits/).
# All regenerable via 02/03/04.
pipeline/yeg/building-permits/output/permit_aggregates/permit_aggregates_*.csv
pipeline/yeg/building-permits/output/permit_coverage_summary.csv
pipeline/yeg/building-permits/output/manifest.json
pipeline/yeg/building-permits/output/permits_coverage.csv
pipeline/yeg/building-permits/output/permits_category_counts.csv
# Dwelling-units dropped-spanner diagnostic CSVs (per-run, dated) — regenerable
# build diagnostics, same policy as the aggregates above.
pipeline/yeg/building-permits/output/dwelling_units_*.csv
# EDA composition-recon CSVs (eda/01d building-type, eda/01e work-type, and any
# future *_by_group recon) — exploratory, regenerable, never a published artifact.
pipeline/yeg/building-permits/output/*_by_group.csv
pipeline/yeg/building-permits/output/*_by_group_year.csv

